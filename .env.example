# Local development only. Placeholders: never put real credentials in this file or in git.
# Production values arrive through the platform's secret intake (see docs/ARCHITECTURE.md).

# --- api ---
FH_ENV=local
DATABASE_URL=postgresql+psycopg://family_history:local-dev-only@localhost:5544/family_history
DIRECT_DATABASE_URL=postgresql+psycopg://family_history:local-dev-only@localhost:5544/family_history
REDIS_URL=redis://localhost:6390/0
FH_JANUA_ISSUER=https://auth.madfam.io
FH_JANUA_AUDIENCE=family-history-api
FH_AUTH_DISABLED=true
FH_CORS_ORIGINS=http://localhost:3000
FH_EARLY_ACCESS_ALLOWLIST=
FH_S3_ENDPOINT=http://localhost:9000
FH_S3_BUCKET=family-history-media-local
FH_S3_ACCESS_KEY_ID=local-dev-only
FH_S3_SECRET_ACCESS_KEY=local-dev-only
FH_S3_REGION=auto

# --- web ---
AUTH_JANUA_ISSUER=https://auth.madfam.io
AUTH_JANUA_CLIENT_ID=
AUTH_JANUA_CLIENT_SECRET=
FH_SESSION_SECRET=
FH_PUBLIC_LANDING_HOST=localhost:3000
FH_PUBLIC_APP_HOST=app.localhost:3000
FH_API_INTERNAL_URL=http://localhost:8000
FH_INDEXABLE=false
